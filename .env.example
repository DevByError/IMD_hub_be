# --- App ---
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=imd_hub
DB_USER=imd_hub_app
DB_PASSWORD=changeme

# --- Auth ---
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Email (Gmail SMTP for dev; move to a transactional provider for production) ---
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=replace_with_app_password

# --- Cookies ---
COOKIE_DOMAIN=localhost

# --- Encryption ---
# AES-256 key for encrypting sensitive fields at rest (currently: ID document
# number — passport/IC). Must be base64 and decode to exactly 32 bytes.
# Generate with: openssl rand -base64 32
# Losing/rotating this key without a migration plan makes existing encrypted
# values unreadable — back it up like any other production secret.
ID_DOCUMENT_ENCRYPTION_KEY=replace_with_output_of_openssl_rand_-base64_32(node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")

# --- One-time bootstrap: creates the single root Manager account when you
# --- run `npm run seed`. Change the password after first login, then these
# --- vars are no longer needed. ---
BOOTSTRAP_MANAGER_NAME=Department Manager
BOOTSTRAP_MANAGER_EMAIL=manager@example.com
BOOTSTRAP_MANAGER_PASSWORD=changeme_before_seeding
